NEXT_PUBLIC_SENTINEL_API_URL=http://localhost:8081
DATABASE_URL=postgres://stellar:stellar@localhost:5433/stellar_inspector?sslmode=disable
SENTINEL_ADDRESS=:8080
SENTINEL_ALLOWED_ORIGINS=http://localhost:3000
# Deja ambos vacíos para desarrollo abierto. En producción usa tokens aleatorios y un secreto de 32+ caracteres.
SENTINEL_AUTH_TOKENS=
SENTINEL_SESSION_SECRET=
SENTINEL_SESSION_TTL=12h
SENTINEL_COOKIE_SECURE=false
SENTINEL_RATE_LIMIT_WINDOW=1m
SENTINEL_RATE_LIMIT_IP=120
SENTINEL_RATE_LIMIT_ACCOUNT=30
# Sólo configura proxies que realmente controles; de otro modo X-Forwarded-For se ignora.
SENTINEL_TRUSTED_PROXY_CIDRS=
HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org
HORIZON_MAINNET_URL=https://horizon.stellar.org
SENTINEL_HTTP_TIMEOUT=45s
SENTINEL_RECONNECT_MAX_BACKOFF=30s
