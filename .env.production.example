DOMAIN=sentinel.example.com
ACME_EMAIL=ops@example.com
# Usa sólo caracteres URL-safe porque este valor forma parte de DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
SENTINEL_AUTH_TOKENS=replace-with-a-long-random-access-token
SENTINEL_SESSION_SECRET=replace-with-at-least-32-random-characters
SENTINEL_VERSION=local

# Canales opcionales: configura cada bloque completo o déjalo vacío.
SENTINEL_WEBHOOK_URL=
SENTINEL_WEBHOOK_SECRET=
SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USERNAME=
SENTINEL_SMTP_PASSWORD=
SENTINEL_SMTP_FROM=
SENTINEL_SMTP_TO=
SENTINEL_SMTP_TLS=starttls
