{
  "name": "stellar-account-inspector",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @stellar-inspector/web dev",
    "build": "pnpm --filter @stellar-inspector/web build",
    "lint": "pnpm --filter @stellar-inspector/web lint",
    "test": "pnpm --filter @stellar-inspector/web test",
    "sentinel:test": "go -C services/sentinel-api test ./...",
    "sentinel:test:integration": "docker compose up -d --wait postgres && go -C services/sentinel-api test -tags=integration ./internal/integration -v",
    "sentinel:up": "docker compose up -d --build",
    "sentinel:down": "docker compose down",
    "sentinel:logs": "docker compose logs -f sentinel-api"
  }
}
